# Copy to .env.local for development. In production set these in Vercel → Settings → Environment Variables.

# Public base URL (used for canonical links, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.katib.me

# Admin sign-in — generate both with: npm run hash-password
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# Upstash Redis — added automatically when you connect Upstash from the Vercel Marketplace.
# Without it the site serves the built-in content and the admin can't save.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# …or, for a database created directly on upstash.com:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
